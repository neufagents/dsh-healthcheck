{
  "name": "dsh-healthcheck",
  "version": "0.1.0",
  "description": "Runtime health check for DeepSeek Harness: session-library scan + crash-tail inspection. Read-only.",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.1.6-0 || >=0.1.6-alpha.1 <0.2.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/health.spec.ts tests/contract.spec.ts"
  },
  "author": "NeufAgents (neufagents.com)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/neufagents/dsh-healthcheck.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "health-check"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-session": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.5-rc.2"
  }
}
